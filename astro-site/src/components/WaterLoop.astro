---
import { sceneMotion, url } from '../data/site';
const { direction, room = 'main-entrance' } = Astro.props;
const motion = sceneMotion(direction, room);
---
{motion && <video class="water-loop" muted loop playsinline preload="none" aria-hidden="true" tabindex="-1" disablepictureinpicture>
  {motion.sources.map(source => <source src={url(source.src)} type={source.type} />)}
</video>}
<script>import '../scripts/scene-motion.js';</script>
<style>
  .water-loop{position:absolute;inset:0;width:100%;height:100%;object-fit:contain;border-radius:inherit;pointer-events:none;opacity:0}
  :global([data-scene-media][data-playing]) .water-loop{opacity:1}
  :global([data-scene-media]:not([data-room="main-entrance"])) .water-loop{display:none}
</style>
