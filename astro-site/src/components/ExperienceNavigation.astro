---
import { selectedExperiences } from '../data/experiences';
import { url } from '../data/site';
const { slug } = Astro.props;
const index = selectedExperiences.findIndex(experience => experience.slug === slug);
const previous = index >= 0 ? selectedExperiences[(index - 1 + selectedExperiences.length) % selectedExperiences.length] : null;
const next = index >= 0 ? selectedExperiences[(index + 1) % selectedExperiences.length] : null;
---
<nav class="experience-navigation" aria-label="More experiences">
  <a class="collection-link" href={url('experiences/#collection')}>Back to all ten experiences <span aria-hidden="true">↗</span></a>
  {previous && next && <div class="neighbours">
    <a href={url(`experiences/${previous.slug}/`)} rel="prev"><span>← Previous</span><strong>{previous.name}</strong></a>
    <a href={url(`experiences/${next.slug}/`)} rel="next"><span>Next →</span><strong>{next.name}</strong></a>
  </div>}
</nav>
<style>
  .experience-navigation{width:90%;max-width:1600px;margin:0 auto;padding:40px 0 60px;border-top:1px solid #ffffff29;color:#f3f0e8}
  .collection-link{display:inline-flex;align-items:center;gap:32px;font-size:14px;padding:8px 0;border-bottom:1px solid #758397;color:inherit;text-decoration:none}
  .neighbours{display:grid;grid-template-columns:1fr 1fr;gap:32px;margin-top:35px}
  .neighbours a{display:flex;flex-direction:column;gap:10px;text-decoration:none;color:inherit;min-width:0;padding:8px 0}
  .neighbours a:last-child{text-align:right;align-items:flex-end}
  .neighbours span{font-size:12px;color:#b8c3d0}.neighbours strong{font-size:clamp(20px,2.2vw,30px);font-weight:400;line-height:1.2;letter-spacing:-.035em}
  a:hover strong,a:hover.collection-link{color:#d9c3a2}a:focus-visible{outline:2px solid #74dcf5;outline-offset:6px}
  @media(max-width:700px){.experience-navigation{width:calc(100% - 40px);padding:30px 0 40px}.neighbours{gap:25px;margin-top:24px}}
</style>
