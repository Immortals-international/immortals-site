---
import { url } from '../data/site';

// A convenience screen for a public static site, not server-side authorization.
// Keep the password itself out of the published source. Change this digest to rotate it.
const digest = 'a89178e73330ca29c0ea18443330c81b2b09d28dd8fc6073acb3a8cfbecc9a4a';
const storageKey = 'immortals-presentation-access';
---

<script is:inline define:vars={{ digest, storageKey }}>
  try {
    if (sessionStorage.getItem(storageKey) === digest) {
      document.documentElement.setAttribute('data-presentation-unlocked', '');
    }
  } catch { /* A blocked storage API still allows entry on the current page. */ }
</script>

<style is:global is:inline>
  html:not([data-presentation-unlocked]) { overflow: hidden !important; }
  html:not([data-presentation-unlocked]) body > :not(#presentation-access):not(script):not(style) {
    visibility: hidden !important;
    pointer-events: none !important;
  }
  html[data-presentation-unlocked] #presentation-access { display: none; }
  #presentation-access {
    position: fixed; inset: 0; z-index: 2147483647;
    width: 100%; height: 100dvh; max-width: none; max-height: none;
    margin: 0; padding: 32px 24px; border: 0; box-sizing: border-box;
    background: #0c1220; color: #f3f0e7; overflow-y: auto;
    font-family: Mori, 'PP Mori', Arial, sans-serif;
  }
  #presentation-access[open] { display: grid; place-items: center; }
  #presentation-access::backdrop { background: #0c1220; }
  #presentation-access .access-panel { width: min(100%, 400px); }
  #presentation-access .access-wordmark { display: block; width: 210px; height: auto; margin: 0 0 64px; }
  #presentation-access h2 { margin: 0 0 16px; font-size: clamp(34px, 7vw, 42px); line-height: 1.1; font-weight: 400; letter-spacing: -.04em; }
  #presentation-access p { margin: 0 0 32px; color: #b8c1cd; font-size: 15px; line-height: 1.6; }
  #presentation-access label { display: block; margin-bottom: 10px; font-size: 13px; }
  #presentation-access input { box-sizing: border-box; width: 100%; min-height: 54px; padding: 14px 16px; border: 1px solid #697383; border-radius: 0; background: #141d2c; color: #f3f0e7; font: inherit; font-size: 16px; }
  #presentation-access input:focus-visible, #presentation-access button:focus-visible { outline: 2px solid #aebfd4; outline-offset: 4px; }
  #presentation-access input[aria-invalid='true'] { border-color: #e6aaa3; }
  #presentation-access .access-error { min-height: 24px; margin: 10px 0 14px; color: #e6aaa3; font-size: 13px; }
  #presentation-access button { display: flex; justify-content: space-between; align-items: center; gap: 20px; width: 100%; min-height: 54px; padding: 15px 18px; border: 1px solid #f3f0e7; border-radius: 0; background: #f3f0e7; color: #0c1220; font: inherit; font-size: 14px; cursor: pointer; }
  #presentation-access button:disabled { opacity: .65; cursor: wait; }
  @media (max-height: 500px) { #presentation-access .access-wordmark { margin-bottom: 28px; } }
</style>

<dialog id="presentation-access" open aria-labelledby="access-title" aria-describedby="access-description" data-digest={digest} data-storage-key={storageKey}>
  <div class="access-panel">
    <img class="access-wordmark" src={url('assets/wordmark.png')} alt="Immortals" width="210" height="19" />
    <h2 id="access-title">Macau presentation</h2>
    <p id="access-description">Enter the password to continue.</p>
    <form id="presentation-access-form">
      <label for="presentation-password">Password</label>
      <input id="presentation-password" name="password" type="password" autocomplete="current-password" required aria-describedby="access-error" />
      <p id="access-error" class="access-error" role="status" aria-live="polite"></p>
      <button type="submit"><span>Enter presentation</span><span aria-hidden="true">↗</span></button>
    </form>
    <noscript><style>#presentation-access-form{display:none}</style><p>Enable JavaScript to enter the presentation.</p></noscript>
  </div>
</dialog>

<script>
  import '../scripts/presentation-access.js';
</script>
