---
import { sceneImage, sceneDimensions } from '../data/site';
import WaterLoop from './WaterLoop.astro';
const { direction, room, loading = 'lazy', priority = 'auto' } = Astro.props;
const dimensions = sceneDimensions(direction.id, room.id);
const caption = `${direction.name} · ${room.name}`;
---
<div class="scene-media" data-scene-media data-room={room.id}>
  <button type="button" class="image-button" data-lightbox={sceneImage(direction.id,room.id)} data-caption={caption} aria-label={`Enlarge ${caption}`}>
    <img src={sceneImage(direction.id,room.id)} alt={caption} width={dimensions.width} height={dimensions.height} loading={loading} fetchpriority={priority} draggable="false" />
    <WaterLoop direction={direction.id} room={room.id} />
    <span>View full image <span aria-hidden="true">↗</span></span>
  </button>
</div>
<style>
  .scene-media{position:relative;min-width:0}
  .scene-media .image-button{touch-action:pan-x pan-y pinch-zoom}
  .scene-media .image-button:focus-visible{outline-offset:-4px}
  .scene-media img{display:block;width:100%;height:auto;aspect-ratio:16/9;object-fit:contain;user-select:none;background:#142034}
</style>
