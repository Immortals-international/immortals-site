---
import SiteLayout from '../../layouts/SiteLayout.astro';
import { url, styles, feedback } from '../../data/site';
import { directionConcepts } from '../../data/directionConcepts';
import DirectionCarousel from '../../components/DirectionCarousel.astro';
export function getStaticPaths(){return styles.map(style=>({params:{slug:style.slug},props:{style}}));}
const {style:s}=Astro.props;
const concept=directionConcepts[s.id];
const others=styles.filter(style=>style.id!==s.id);
---
<SiteLayout title={s.name} description={s.summary} active="interior-design">
<section class="wrap page-heading direction-heading">
  <div class="breadcrumb"><a href={url()}>Macau flagship</a><span>/</span><a href={url('interior-design/')}>Interior Design</a><span>/</span><span>{s.name}</span></div>
  <h1>{s.name}</h1>
  <p>{s.summary}</p>
</section>
<div class="wrap direction-study">
  <DirectionCarousel direction={s} />
  <aside class="direction-concept" aria-label="The design approach">
    <div><h2>The idea</h2><p>{s.idea}</p></div>
    <div><h2>Inspiration</h2><p>{concept.inspiration}</p>{concept.reference && <a class="concept-reference" href={concept.reference.href} target="_blank" rel="noopener">{concept.reference.label} <span aria-hidden="true">↗</span></a>}</div>
    <div><h2>Why it suits Immortals</h2><p>{concept.rationale}</p></div>
  </aside>
  <p class="direction-note">Concept visualisations illustrate design intent. Room proportions, equipment clearances and technical specifications require coordination with the selected floor plan.</p>
  <a class="text-link" href={url('interior-design/supplement-lab/')}>View the supplement lab concept <span aria-hidden="true">↗</span></a>
</div>
<section class="cream" aria-labelledby="other-directions-title"><div class="wrap direction-navigation">
  <h2 id="other-directions-title">Explore another direction.</h2>
  <nav class="other-directions" aria-label="Other design directions">
    {others.map(other => <a href={url(`interior-design/${other.slug}/`)}><span>{other.name}</span><span aria-hidden="true">↗</span></a>)}
  </nav>
  <div class="actions"><a class="button" href={url('interior-design/#compare')}>Compare all four <span aria-hidden="true">↗</span></a><a class="text-link" href={feedback} target="_blank" rel="noopener">Share feedback <span aria-hidden="true">↗</span></a></div>
</div></section>
</SiteLayout>

<style>
  .direction-heading{padding-top:32px;padding-bottom:32px}
  .direction-heading .breadcrumb{margin-bottom:26px}
  .direction-heading h1{font-size:clamp(42px,6.1vw,88px)}
  .direction-heading>p{font-size:15px;color:var(--muted);max-width:700px;margin-top:22px}
  .direction-study{display:grid;grid-template-columns:minmax(0,2fr) minmax(0,1fr);gap:28px clamp(32px,4vw,64px);align-items:start;padding-bottom:42px}
  .direction-concept{display:grid;gap:26px}
  .direction-concept>div+div{border-top:1px solid var(--line);padding-top:24px}
  .direction-concept h2{font-size:22px;line-height:1.2;letter-spacing:-.025em}
  .direction-concept p{font-size:14px;line-height:1.7;color:var(--muted);margin-top:12px}
  .concept-reference{display:inline-flex;gap:16px;align-items:center;font-size:12px;border-bottom:1px solid #738092;padding:8px 0 6px;margin-top:6px}
  .concept-reference:hover{color:var(--sand)}
  .direction-note{grid-column:1/-1;font-size:11px;line-height:1.7;color:var(--muted);max-width:860px}
  .direction-navigation{padding-top:58px;padding-bottom:64px}
  .direction-navigation h2{font-size:clamp(30px,3vw,44px);margin-bottom:30px}
  .other-directions{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:24px}
  .other-directions a{display:flex;justify-content:space-between;align-items:center;gap:22px;border-top:1px solid var(--dark-line);border-bottom:1px solid var(--dark-line);padding:24px 0;font-size:clamp(20px,2vw,28px);line-height:1.25}
  .other-directions a>span:last-child{font-size:19px;color:#53606c}
  .other-directions a:hover{color:#786348}
  @media(max-width:1100px){
    .direction-study{grid-template-columns:1fr;row-gap:32px}
    .direction-concept{grid-template-columns:repeat(3,minmax(0,1fr));gap:26px}
    .direction-concept>div,.direction-concept>div+div{border-top:1px solid var(--line);padding-top:24px}
  }
  @media(max-width:700px){
    .direction-heading{padding-top:24px;padding-bottom:26px}
    .direction-heading .breadcrumb{margin-bottom:22px}
    .direction-heading h1{font-size:clamp(37px,9.5vw,58px)}
    .direction-heading>p{font-size:14px;margin-top:18px}
    .direction-study{padding-bottom:32px}
    .direction-concept{grid-template-columns:1fr;gap:24px}
    .direction-concept h2{font-size:22px}
    .direction-note{font-size:10px}
    .direction-navigation{padding-top:40px;padding-bottom:42px}
    .other-directions{grid-template-columns:1fr;gap:0}
    .other-directions a{font-size:24px;padding:20px 0;border-bottom:0}
    .other-directions a:last-child{border-bottom:1px solid var(--dark-line)}
  }
</style>
