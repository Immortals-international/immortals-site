---
import SiteLayout from '../../layouts/SiteLayout.astro';
import SceneMedia from '../../components/SceneMedia.astro';
import LabPreview from '../../components/LabPreview.astro';
import { url, styles, rooms, sceneImage, sceneDimensions, feedback } from '../../data/site';
---
<SiteLayout title="Interior Design" description="Compare four design directions for Immortals Macau across the same six clinic spaces." active="interior-design">
  <section class="wrap page-heading design-heading">
    <div class="breadcrumb"><a href={url()}>Macau flagship</a><span>/</span><span>Interior Design</span></div>
    <h1>Four design directions.</h1>
    <p>Select a room to compare four interpretations of the same clinic. Open an image for a closer look, or explore a direction in detail.</p>
  </section>

  <section class="wrap design-comparison" id="compare" aria-label="Compare the four design directions">
    <div class="comparison-tools" role="group" aria-label="Room to compare">
      {rooms.map((room,i) => <button class="chip" data-compare-room={room.id} aria-pressed={i===0}>{room.name}</button>)}
    </div>
    <p id="comparison-room-label" class="visually-hidden" role="status">{rooms[0].name} shown in all four directions.</p>
    <div class="comparison-grid">
      {styles.map((style,i) => <article class="comparison-card" data-style={style.id} data-style-name={style.name} data-scene-dimensions={JSON.stringify(Object.fromEntries(rooms.map(room => [room.id, sceneDimensions(style.id,room.id)])))} data-scene-sources={JSON.stringify(Object.fromEntries(rooms.map(room => [room.id, sceneImage(style.id,room.id)])))}>
        <SceneMedia direction={style} room={rooms[0]} loading={i<2?'eager':'lazy'} />
        <div class="direction-details">
          <h2>{style.name}</h2>
          <a class="direction-link" href={url(`interior-design/${style.slug}/`)} aria-label={`Explore ${style.name}`}>Explore <span aria-hidden="true">↗</span></a>
        </div>
      </article>)}
    </div>
    <p class="fine comparison-note">Concept visualisations illustrate atmosphere, material and design intent. Room proportions, equipment clearances and final arrangements need architectural and technical coordination.</p>
  </section>

  <LabPreview />

  <section class="cream">
    <div class="wrap design-feedback">
      <div><h2>Share your preference.</h2><p>Tell us which direction you prefer and what you would change.</p></div>
      <div class="actions"><a class="button" href={feedback} target="_blank" rel="noopener">Share feedback <span aria-hidden="true">↗</span></a><a class="text-link" href={url('layout/')}>Compare the layouts <span aria-hidden="true">↗</span></a></div>
    </div>
  </section>
  <script>
    document.querySelectorAll<HTMLButtonElement>('[data-compare-room]').forEach(button=>button.addEventListener('click',()=>{
      const comparison=document.querySelector<HTMLElement>('#compare')!;
      const grid=document.querySelector<HTMLElement>('.comparison-grid')!;
      const headerBottom=document.querySelector('.clinic-header')!.getBoundingClientRect().bottom;
      if (matchMedia('(min-width:1001px) and (min-height:600px)').matches &&
          (comparison.getBoundingClientRect().top < headerBottom - 1 || grid.getBoundingClientRect().bottom > innerHeight)) {
        comparison.scrollIntoView({block:'start',behavior:matchMedia('(prefers-reduced-motion:reduce)').matches?'instant':'smooth'});
      }
      const room=button.dataset.compareRoom!;
      const name=button.textContent!.trim();
      document.querySelectorAll('[data-compare-room]').forEach(b=>b.setAttribute('aria-pressed',String(b===button)));
      document.querySelector('#comparison-room-label')!.textContent=`${name} shown in all four directions.`;
      document.querySelectorAll<HTMLElement>('.comparison-card').forEach(card=>{
        const image=card.querySelector('img')!;
        const trigger=card.querySelector<HTMLButtonElement>('[data-lightbox]')!;
        const caption=`${card.dataset.styleName} · ${name}`;
        image.src=JSON.parse(card.dataset.sceneSources!)[room];
        image.alt=caption;
        const dimensions=JSON.parse(card.dataset.sceneDimensions!)[room];
        image.width=dimensions.width;
        image.height=dimensions.height;
        card.querySelector<HTMLElement>('[data-scene-media]')!.dataset.room=room;
        trigger.dataset.lightbox=image.src;
        trigger.dataset.caption=caption;
        trigger.setAttribute('aria-label',`Enlarge ${caption}`);
      });
    }));
  </script>
</SiteLayout>

<style>
  .design-heading{padding-top:32px;padding-bottom:28px}
  .design-heading .breadcrumb{margin-bottom:26px}
  .design-heading h1{font-size:clamp(44px,6.1vw,88px)}
  .design-heading>p{max-width:670px;margin-top:22px;color:var(--muted);font-size:15px}
  :global(html:has(.design-comparison)){scroll-padding-top:88px}
  .design-comparison{--comparison-header:88px;padding-bottom:68px;scroll-margin-top:0}
  .comparison-tools{position:sticky;top:var(--comparison-header);z-index:20;display:flex;flex-wrap:nowrap;gap:8px;margin:0;padding:8px 0 12px;background:var(--bg,#0c1220);overflow-x:auto;scrollbar-width:thin;scrollbar-color:#687b91 #0c1220}
  .comparison-tools::-webkit-scrollbar{height:4px}
  .comparison-tools::-webkit-scrollbar-track{background:#0c1220}
  .comparison-tools::-webkit-scrollbar-thumb{background:#687b91;border-radius:4px}
  .comparison-tools .chip{flex:0 0 auto;min-height:44px;padding:10px 14px;font-size:13px;white-space:nowrap}
  .comparison-grid{gap:16px 24px;width:100%;margin:0 auto}
  .comparison-card{display:flex;flex-direction:column;min-width:0}
  .comparison-card :global(.scene-media){display:block;padding:0}
  .comparison-card :global(.image-button){aspect-ratio:16/9;overflow:hidden}
  .design-comparison .comparison-card :global(.scene-media img){width:100%;height:100%;aspect-ratio:16/9;object-fit:cover;object-position:center}
  .comparison-card :global(.water-loop){object-fit:cover;object-position:center}
  .comparison-card>.direction-details{display:flex;flex-direction:row;align-items:center;justify-content:space-between;gap:16px;min-height:44px;padding:0}
  .direction-details h2{font-size:clamp(18px,1.55vw,25px);line-height:1.2;letter-spacing:-.035em}
  .direction-link{display:inline-flex;align-items:center;gap:12px;flex-shrink:0;min-height:44px;font-size:12px;color:var(--muted);text-decoration:underline;text-decoration-color:#ffffff40;text-underline-offset:5px}
  .direction-link:hover{color:var(--bone);text-decoration-color:currentColor}
  .comparison-note{margin:28px auto 0;max-width:850px}
  /* Keep the full page width; crop previews to fit two rows below the controls. */
  @media(min-width:1001px) and (min-height:600px){
    .comparison-card :global(.image-button){height:calc((100svh - var(--comparison-header) - 184px) / 2);aspect-ratio:auto}
    .design-comparison .comparison-card :global(.scene-media img){aspect-ratio:auto}
  }
  @media(max-width:1000px){:global(html:has(.design-comparison)){scroll-padding-top:72px}.design-comparison{--comparison-header:72px}}
  .visually-hidden{position:absolute;width:1px;height:1px;padding:0;overflow:hidden;clip-path:inset(50%);white-space:nowrap}
  .design-feedback{padding-top:58px;padding-bottom:58px;display:flex;align-items:center;justify-content:space-between;gap:35px}
  .design-feedback h2{font-size:clamp(32px,3.4vw,48px)}
  .design-feedback p{font-size:14px;color:#53606c;margin-top:16px}
  .design-feedback .actions{margin:0;flex-shrink:0}
  @media(max-width:1100px){.design-feedback{display:block}.design-feedback .actions{margin-top:26px}}
  @media(max-width:700px){
    .design-heading{padding-top:24px;padding-bottom:24px}
    .design-heading .breadcrumb{margin-bottom:22px}
    .design-heading h1{font-size:clamp(38px,10vw,58px)}
    .design-heading>p{font-size:14px;margin-top:18px}
    .comparison-tools .chip{font-size:12px;padding:10px 12px}
    .comparison-grid{gap:24px;grid-template-columns:1fr}
    .direction-details h2{font-size:23px}
    .design-comparison{padding-bottom:42px}
    .comparison-note{margin-top:28px}
    .design-feedback{padding-top:40px;padding-bottom:40px}
  }
</style>
