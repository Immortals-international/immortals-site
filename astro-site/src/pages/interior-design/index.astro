---
import SiteLayout from '../../layouts/SiteLayout.astro';
import SceneMedia from '../../components/SceneMedia.astro';
import { url, styles, rooms, sceneImage, feedback } from '../../data/site';
---
<SiteLayout title="Interior Design" description="Compare four design directions for Immortals Macau across the same six clinic spaces." active="interior-design">
  <section class="wrap page-heading design-heading">
    <div class="breadcrumb"><a href={url()}>Macau flagship</a><span>/</span><span>Interior Design</span></div>
    <h1>Four design directions.</h1>
    <p>Select a room to compare four interpretations of the same clinic. Open an image for a closer look, or explore a direction in detail.</p>
  </section>

  <section class="wrap design-comparison" id="compare" aria-label="Compare the four design directions">
    <div class="comparison-tools" role="group" aria-label="Room to compare">
      {rooms.map((room,i) => <button class="chip" data-compare-room={room.id} aria-pressed={i===0}>{room.name}</button>)}
    </div>
    <p id="comparison-room-label" class="visually-hidden" role="status">{rooms[0].name} shown in all four directions.</p>
    <div class="comparison-grid">
      {styles.map((style,i) => <article class="comparison-card" data-style={style.id} data-style-name={style.name} data-scene-sources={JSON.stringify(Object.fromEntries(rooms.map(room => [room.id, sceneImage(style.id,room.id)])))}>
        <SceneMedia direction={style} room={rooms[0]} loading={i<2?'eager':'lazy'} />
        <div class="direction-details">
          <h2>{style.name}</h2>
          <p>{style.summary}</p>
          <a class="button direction-link" href={url(`interior-design/${style.slug}/`)} aria-label={`Explore ${style.name}`}>Explore direction <span aria-hidden="true">↗</span></a>
        </div>
      </article>)}
    </div>
    <p class="fine comparison-note">Concept visualisations illustrate atmosphere, material and design intent. Room proportions, equipment clearances and final arrangements need architectural and technical coordination.</p>
  </section>

  <section class="cream">
    <div class="wrap design-feedback">
      <div><h2>Share your preference.</h2><p>Tell us which direction you prefer and what you would change.</p></div>
      <div class="actions"><a class="button" href={feedback} target="_blank" rel="noopener">Share feedback <span aria-hidden="true">↗</span></a><a class="text-link" href={url('layout/')}>Compare the layouts <span aria-hidden="true">↗</span></a></div>
    </div>
  </section>
  <script>
    document.querySelectorAll<HTMLButtonElement>('[data-compare-room]').forEach(button=>button.addEventListener('click',()=>{
      const room=button.dataset.compareRoom!;
      const name=button.textContent!.trim();
      document.querySelectorAll('[data-compare-room]').forEach(b=>b.setAttribute('aria-pressed',String(b===button)));
      document.querySelector('#comparison-room-label')!.textContent=`${name} shown in all four directions.`;
      document.querySelectorAll<HTMLElement>('.comparison-card').forEach(card=>{
        const image=card.querySelector('img')!;
        const trigger=card.querySelector<HTMLButtonElement>('[data-lightbox]')!;
        const caption=`${card.dataset.styleName} · ${name}`;
        image.src=JSON.parse(card.dataset.sceneSources!)[room];
        image.alt=caption;
        image.width=room==='main-entrance'?1536:1600;
        image.height=room==='main-entrance'?1024:900;
        card.querySelector<HTMLElement>('[data-scene-media]')!.dataset.room=room;
        trigger.dataset.lightbox=image.src;
        trigger.dataset.caption=caption;
        trigger.setAttribute('aria-label',`Enlarge ${caption}`);
      });
    }));
  </script>
</SiteLayout>

<style>
  .design-heading{padding-top:32px;padding-bottom:28px}
  .design-heading .breadcrumb{margin-bottom:26px}
  .design-heading h1{font-size:clamp(44px,6.1vw,88px)}
  .design-heading>p{max-width:670px;margin-top:22px;color:var(--muted);font-size:15px}
  .design-comparison{padding-bottom:68px}
  .comparison-tools{margin:0 0 28px}
  .comparison-grid{gap:46px 26px}
  .comparison-card :global(img){aspect-ratio:auto}
  .comparison-card{display:flex;flex-direction:column}
  .comparison-card>.direction-details{display:flex;flex-direction:column;align-items:flex-start;gap:0;flex:1;padding-top:20px}
  .direction-details h2{font-size:clamp(25px,2.3vw,34px);line-height:1.15}
  .direction-details>p{font-size:14px;line-height:1.6;color:var(--muted);max-width:560px;margin:14px 0 22px}
  .direction-link{margin-top:auto;min-height:44px;padding:10px 16px;gap:28px;font-size:12px;font-weight:400;border-color:#ffffff40}
  .direction-link:hover{background:#ffffff08;color:var(--bone);border-color:#ffffff80}
  .comparison-note{margin-top:36px;max-width:850px}
  .visually-hidden{position:absolute;width:1px;height:1px;padding:0;overflow:hidden;clip-path:inset(50%);white-space:nowrap}
  .design-feedback{padding-top:58px;padding-bottom:58px;display:flex;align-items:center;justify-content:space-between;gap:35px}
  .design-feedback h2{font-size:clamp(32px,3.4vw,48px)}
  .design-feedback p{font-size:14px;color:#53606c;margin-top:16px}
  .design-feedback .actions{margin:0;flex-shrink:0}
  @media(max-width:1100px){.design-feedback{display:block}.design-feedback .actions{margin-top:26px}}
  @media(max-width:700px){
    .design-heading{padding-top:24px;padding-bottom:24px}
    .design-heading .breadcrumb{margin-bottom:22px}
    .design-heading h1{font-size:clamp(38px,10vw,58px)}
    .design-heading>p{font-size:14px;margin-top:18px}
    .comparison-tools{margin:0 0 24px;gap:8px}
    .comparison-tools .chip{flex:1 1 calc(50% - 8px);font-size:12px;padding:12px 10px}
    .comparison-grid{gap:36px;grid-template-columns:1fr}
    .comparison-card>.direction-details{padding-top:16px}
    .direction-details h2{font-size:28px}
    .direction-details>p{font-size:13px;margin-top:12px}
    .design-comparison{padding-bottom:42px}
    .comparison-note{margin-top:28px}
    .design-feedback{padding-top:40px;padding-bottom:40px}
  }
</style>
